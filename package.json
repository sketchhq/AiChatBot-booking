{
  "name": "carepoint-health-api",
  "version": "1.0.0",
  "description": "CarePoint Health — AI Appointment Booking Backend",
  "author": "sketchhq",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "start:seeder": "ts-node -r tsconfig-paths/register src/seeds/run-seeder.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./data-source.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d ./data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.999.0",
    "@aws-sdk/s3-request-presigner": "^3.999.0",
    "@getbrevo/brevo": "^3.0.1",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sendgrid/mail": "^7.7.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/cache-manager": "^4.0.2",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.7.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cli-highlight": "^2.1.11",
    "cookie-parser": "^1.4.6",
    "cron": "^2.4.4",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express-device": "^0.4.2",
    "express-rate-limit": "^7.1.1",
    "force": "^0.0.3",
    "fs": "^0.0.1-security",
    "geojson": "^0.5.0",
    "google-auth-library": "^10.5.0",
    "groq-sdk": "^1.1.2",
    "helmet": "^7.1.0",
    "html-pdf": "^3.0.1",
    "luxon": "^3.5.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "multer": "^1.4.5-lts.1",
    "nestjs-class-validator": "^0.1.2",
    "nestjs-schedule": "^0.1.7",
    "nodejs-base64-encode": "^1.1.0",
    "nodemailer": "^6.9.16",
    "openai": "^6.27.0",
    "or": "^0.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
